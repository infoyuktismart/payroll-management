# ─────────────────────────────────────────────────────────────
# Supabase Configuration
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ⚠️  WARNING: NEVER add SUPABASE_SERVICE_ROLE_KEY or any secret
# key with a VITE_ prefix. The VITE_ prefix exposes values to the
# browser bundle and anyone who visits your app can read them.
# Service role keys bypass all RLS — exposure is catastrophic.

# ─────────────────────────────────────────────────────────────
# Error Tracking (Phase 5)
# ─────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ─────────────────────────────────────────────────────────────
# App Config
# ─────────────────────────────────────────────────────────────
VITE_APP_NAME=PayrollPro
VITE_APP_VERSION=1.0.0
