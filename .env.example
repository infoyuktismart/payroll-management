VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Edge Function secrets for send-notification
# Set these with: npx supabase secrets set RESEND_API_KEY=... NOTIFICATION_FROM_EMAIL="Payroll <payroll@yourdomain.com>"
RESEND_API_KEY=your-resend-api-key
NOTIFICATION_FROM_EMAIL="Payroll Management <payroll@yourdomain.com>"
